{
  "manifest_version": 3,
  "name": "ShopOpti Product Importer",
  "version": "1.1.0",
  "description": "Prepare AliExpress product data for import into ShopOpti.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*.aliexpress.com/*",
    "https://shopopti.io/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.aliexpress.com/item/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
