{
  "manifest_version": 3,
  "name": "ShopOpti Product Importer",
  "version": "1.1.0",
  "description": "Capture product pages from supported suppliers and continue the import securely in ShopOpti.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://*.aliexpress.com/*",
    "https://*.amazon.com/*",
    "https://*.amazon.fr/*",
    "https://*.amazon.de/*",
    "https://*.amazon.es/*",
    "https://*.amazon.it/*",
    "https://*.amazon.co.uk/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.aliexpress.com/item/*",
        "https://*.amazon.com/*/dp/*",
        "https://*.amazon.fr/*/dp/*",
        "https://*.amazon.de/*/dp/*",
        "https://*.amazon.es/*/dp/*",
        "https://*.amazon.it/*/dp/*",
        "https://*.amazon.co.uk/*/dp/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}